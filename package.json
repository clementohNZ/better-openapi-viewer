{
  "name": "better-openapi-viewer",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --filter=!example-core",
    "lint": "turbo run lint",
    "pack:check": "pnpm run build && cd packages/core && npm pack --dry-run && cd ../ui && npm pack --dry-run && cd ../nestjs && npm pack --dry-run",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prettier": "^3.5.3",
    "turbo": "^2.9.9",
    "typescript": "^6.0.3"
  }
}
